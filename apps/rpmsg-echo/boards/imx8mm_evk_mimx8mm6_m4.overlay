/*
 * XPI-iMX8MM: Linux 側 DT (kmm-yocto imx8mm-xpi-kart.dts) との取り決め:
 * - vdevbuffer 予約領域 = 0xB8400000 0x100000 (shared-dma-pool)
 *   → vring/バッファは全部この中にカーネルが確保する (Zephyr 側の
 *     リソーステーブルは da=-1 でホスト任せ)。ここを ipc_shm 窓にする
 * - MU: A53 側 mboxes = <&mu 0 1 &mu 1 1 &mu 3 1> (idx1) — IPM ID は
 *   prj/board conf 側で合わせる
 */
/ {
	chosen {
		zephyr,ipc_shm = &shram;
		zephyr,ipc = &mailbox0;
	};

	shram: memory@b8400000 {
		compatible = "mmio-sram";
		reg = <0xb8400000 0x100000>;
	};
};

&mailbox0 {
	status = "okay";
};
